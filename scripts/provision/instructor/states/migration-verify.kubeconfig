apiVersion: v1
clusters:
- cluster:
    certificate-authority-data: 
    server: https://5D041B420F2B8521D1F33B150782CCFF.gr7.us-west-2.eks.amazonaws.com
  name: arn:aws:eks:us-west-2:771128797125:cluster/migration-verify
contexts:
- context:
    cluster: arn:aws:eks:us-west-2:771128797125:cluster/migration-verify
    namespace: argocd
    user: arn:aws:eks:us-west-2:771128797125:cluster/migration-verify
  name: arn:aws:eks:us-west-2:771128797125:cluster/migration-verify
current-context: arn:aws:eks:us-west-2:771128797125:cluster/migration-verify
kind: Config
users:
- name: arn:aws:eks:us-west-2:771128797125:cluster/migration-verify
  user:
    exec:
      apiVersion: client.authentication.k8s.io/v1beta1
      args:
      - --region
      - us-west-2
      - eks
      - get-token
      - --cluster-name
      - migration-verify
      - --output
      - json
      command: aws
      env:
      - name: AWS_PROFILE
        value: kcd-instructor
      interactiveMode: IfAvailable
      provideClusterInfo: false
