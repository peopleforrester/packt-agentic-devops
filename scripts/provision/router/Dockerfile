# ABOUTME: The fleet router: Caddy mapping each studentN hostname to that cluster's NLB.
# ABOUTME: Caddyfile is generated by `fleet.sh routes`; routes change via reload, not redeploy.
FROM caddy:2-alpine

# The baked Caddyfile is the seed/default. At runtime Caddy serves the copy on the /config
# volume (see entrypoint.sh), so a route change is an upload plus 'caddy reload', not a rebuild.
COPY Caddyfile /etc/caddy/Caddyfile
COPY srv/ /srv/
COPY entrypoint.sh /usr/local/bin/entrypoint.sh

# Fail the build rather than the deploy if the generated routing table is malformed. A router
# that boots with a broken config takes every student offline at once.
RUN caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile \
    && chmod +x /usr/local/bin/entrypoint.sh

CMD ["/usr/local/bin/entrypoint.sh"]
